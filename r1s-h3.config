# 1. 目标架构与设备 (NanoPi-R1 / Allwinner H3)
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa7=y
CONFIG_TARGET_sunxi_cortexa7_DEVICE_friendlyarm_nanopi-r1=y
CONFIG_TARGET_ROOTFS_PARTSIZE=380

# 2. 基础包管理器与网络工具 (Docker/物理机均必需)
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# 3. 网页管理后台 (保证浏览器能直接打开 HTTP)
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y

# 4. 磁盘挂载与文件系统 (Docker / TF卡存储扩展必需)
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# 5. 物理网卡与 Wi-Fi 驱动 (TF 卡直刷单独运行必需)
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-rtl8189ftv=y
